{
  "name": "Chili's · Ordering App",
  "short_name": "Chili's",
  "description": "Browse the Chili's demo menu, order for pickup or delivery, track demo orders and earn demo rewards.",
  "lang": "en",
  "dir": "ltr",
  "id": "./",
  "start_url": "app.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#101014",
  "theme_color": "#d71935",
  "categories": ["food", "shopping"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshots/home-1080x1920.png", "sizes": "1080x1920", "type": "image/png", "platform": "narrow", "label": "Home screen with the Triple Dipper hero and featured favorites" },
    { "src": "screenshots/menu-1080x1920.png", "sizes": "1080x1920", "type": "image/png", "platform": "narrow", "label": "Full demo menu with search and category filters" }
  ],
  "shortcuts": [
    { "name": "Browse the Menu", "short_name": "Menu", "description": "See every demo menu item", "url": "app.html#menu", "icons": [{ "src": "icons/shortcut-menu.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Your Cart", "short_name": "Cart", "description": "Jump straight to your demo cart", "url": "app.html#cart", "icons": [{ "src": "icons/shortcut-cart.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Rewards", "short_name": "Rewards", "description": "Check your demo rewards balance", "url": "app.html#rewards", "icons": [{ "src": "icons/shortcut-rewards.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Find a Location", "short_name": "Locations", "description": "Open the sample locations list", "url": "app.html#locations", "icons": [{ "src": "icons/shortcut-locations.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "app.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
